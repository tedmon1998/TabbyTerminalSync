.modal-body
    .d-flex.align-items-center.mb-3
        h3.m-0(translate) Vault is locked

    p.text-muted.mb-3 Enter the master passphrase once. It remains only in memory until the application is closed.

    .input-group
        input.form-control.form-control-lg(
            type='password',
            autofocus,
            [(ngModel)]='passphrase',
            (input)='passphrase = $any($event.target).value',
            #input,
            placeholder='Master passphrase',
            (keyup.enter)='ok()',
            (keyup.esc)='cancel()',
        )
        button.btn.btn-secondary((click)='ok()', *ngIf='passphrase')
            i.fas.fa-check
